{
  "name": "projpoo",
  "version": "1.0.0",
  "description": "Sistema de gerenciamento para barbearias desenvolvido em TypeScript utilizando arquitetura monorepo com backend e frontend.",
  "main": "index.js",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "test": "npm run test --workspace backend",
    "dev": "concurrently \"npm run dev --workspace frontend\" \"npm run dev --workspace backend\"",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspace frontend"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liviasiqueira-creator/projPOO.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/liviasiqueira-creator/projPOO/issues"
  },
  "homepage": "https://github.com/liviasiqueira-creator/projPOO#readme",
  "devDependencies": {
    "concurrently": "^10.0.1"
  },
  "dependencies": {
    "axios": "^1.18.1"
  }
}
